# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/

# Environnement
.env
.env.*
!.env.example

# Base de données (fichiers runtime — ne pas versionner)
*.db
*.sqlite
*.sqlite3

# Fichiers sensibles
*.gnucash
*.log

# Session Playwright persistée (cookies de session LinkedIn) — ne jamais versionner
browser_profile/
profils_extraits.csv
profils_extraits_email.csv
profils_extraits_enrichis.csv
profils_extraits_scores.csv
profils_magasin.csv

# Livrable client xlsx et trace de conversion du re-import (POC-013) — memes
# donnees personnelles que les CSV ci-dessus. Le glob est volontairement large :
# les tests ecrivent leurs classeurs dans tmp_path, jamais dans le depot.
profils_magasin.xlsx
*.xlsx
*.reimport.csv

# Sauvegardes locales des CSV de profils (memes donnees personnelles)
*.csv.bak

# Captures d'ecran de diagnostic POC-005 (contenu de pages LinkedIn)
debug_poc005/

# Fichiers temporaires/jetables (scripts et dumps de diagnostic ponctuels)
tests/temp/

# Correspondance client (PDF), non destinée à être versionnée
document/compte_rendu/

# IDE
.idea/
# Workspace VS Code : chemins locaux a la machine (dossier compte_rendu hors depot).
# Les reglages partageables vivent dans .vscode/settings.json, lui versionne.
*.code-workspace

# Claude Code — mémoire utilisateur (locale, ne pas versionner)
.claude/memory/*.md
!.claude/memory/MEMORY.md

# Inclure explicitement les settings Claude Code (globalement ignorés)
!.claude/settings.local.json
